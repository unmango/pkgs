diff --git a/tests/fixtures/tdl/sample.tdl b/tests/fixtures/tdl/sample.tdl
new file mode 100644
index 0000000..f1b701f
--- /dev/null
+++ b/tests/fixtures/tdl/sample.tdl
@@ -0,0 +1,68 @@
+package shop.orders
+
+import "common.tdl" as common
+
+unit kg
+
+primitive Sku
+
+alias OrderId = string
+
+class Auditable {
+  createdAt: instant
+}
+
+class Paged {
+  type Cursor
+  pageSize: int
+}
+
+mixin Timestamps {
+  createdAt: instant
+}
+
+type Order: Entity, Auditable {
+  id: OrderId
+  shipping: common.Address?
+  items: [LineItem] owned
+  status: Status = Draft
+  weight: decimal<kg>
+  include Timestamps
+}
+
+type LineItem: Entity {
+  sku: Sku
+  quantity: int where { min(1) }
+}
+
+enum Status {
+  Draft
+  Placed { at: instant }
+}
+
+type Page<T> requires Paged<T> {
+  items: [T]
+}
+
+type Cursor {
+  token: string
+}
+
+type Pages {
+  pageSize: int
+}
+
+instance Paged for Pages {
+  type Cursor = Cursor
+}
+
+instance Auditable<common.Address>
+
+type Legacy {
+  note: Unknown
+}
+
+target go for shop.orders {
+  package("orders")
+  Order => key(id)
+}
diff --git a/tests/test_languages.py b/tests/test_languages.py
index 1960405..97e681c 100644
--- a/tests/test_languages.py
+++ b/tests/test_languages.py
@@ -5799,3 +5799,166 @@ def test_julia_qualified_functor_uses_type_not_variable(tmp_path):
     call_nodes = [n for n in r["nodes"] if n["id"].endswith("_call")]
     # Module-qualified receiver types resolve to the bare type, never the variable.
     assert [n["label"] for n in call_nodes] == ["(Box)()"]
+
+
+# ── TDL ───────────────────────────────────────────────────────────────────────
+from graphify.extract import extract, extract_tdl
+
+_needs_tdl = pytest.mark.skipif(
+    _ilu.find_spec("tree_sitter_tdl") is None,
+    reason="tree-sitter-tdl not installed (optional [tdl] extra)",
+)
+
+TDL = FIXTURES / "tdl"
+
+
+def _tdl_edges(r, relation):
+    labels = {n["id"]: n["label"] for n in r["nodes"]}
+    return {
+        (labels.get(e["source"], e["source"]), labels.get(e["target"], e["target"]),
+         e["confidence"])
+        for e in r["edges"] if e["relation"] == relation
+    }
+
+
+@_needs_tdl
+def test_tdl_declarations_are_nodes():
+    r = extract_tdl(TDL / "sample.tdl")
+    assert "error" not in r
+    sourced = {n["label"] for n in r["nodes"] if n["source_file"]}
+    assert sourced == {
+        "sample.tdl", "shop.orders", "kg", "Sku", "OrderId", "Auditable", "Paged",
+        "Timestamps", "Order", "LineItem", "Status", "Page", "Cursor", "Pages",
+        "Legacy",
+    }
+    # Fields, variants, and type parameters are not nodes.
+    assert not {"id", "Draft", "Placed", "T"} & {n["label"] for n in r["nodes"]}
+
+
+@_needs_tdl
+def test_tdl_package_and_file_contain_declarations():
+    r = extract_tdl(TDL / "sample.tdl")
+    contains = _tdl_edges(r, "contains")
