+@_needs_tdl
+def test_tdl_cross_file_edges_land_on_declarations(tmp_path):
+    import shutil
+    shutil.copytree(TDL, tmp_path / "tdl")
+    (tmp_path / "tdl" / "other.tdl").write_text(
+        "package shop.legacy\n\ntype Unknown {\n  note: string\n}\n"
+    )
+    files = sorted((tmp_path / "tdl").rglob("*.tdl"))
+    r = extract(files, root=tmp_path, cache_root=tmp_path, parallel=False)
+    nodes = {n["id"]: n for n in r["nodes"]}
+    def where(nid):
+        n = nodes[nid]
+        return n["label"], Path(n["source_file"]).name
+    edges = {
+        (where(e["source"]), e["relation"], where(e["target"]))
+        for e in r["edges"] if e["source"] in nodes and e["target"] in nodes
+    }
+    assert (("Order", "sample.tdl"), "implements", ("Entity", "std.tdl")) in edges
+    assert (("Order", "sample.tdl"), "references", ("Address", "common.tdl")) in edges
+    assert (("Address", "common.tdl"), "implements", ("Auditable", "sample.tdl")) in edges
+    # The unplaced name binds to its unique definition elsewhere in the corpus.
+    assert (("Legacy", "sample.tdl"), "references", ("Unknown", "other.tdl")) in edges
+    assert all(n["source_file"] for n in r["nodes"])
+
