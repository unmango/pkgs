+def test_tdl_without_the_grammar(monkeypatch):
+    import builtins
+    real_import = builtins.__import__
+    def no_tdl(name, *args, **kwargs):
+        if name == "tree_sitter_tdl":
+            raise ImportError(name)
+        return real_import(name, *args, **kwargs)
+    monkeypatch.setattr(builtins, "__import__", no_tdl)
+    r = extract_tdl(TDL / "sample.tdl")
+    assert r == {"nodes": [], "edges": [], "error": "tree_sitter_tdl not installed"}
