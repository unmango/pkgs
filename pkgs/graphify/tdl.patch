diff --git a/graphify/extractors/tdl.py b/graphify/extractors/tdl.py
new file mode 100644
index 0000000..db7c914
--- /dev/null
+++ b/graphify/extractors/tdl.py
@@ -0,0 +1,280 @@
+"""TDL extractor (tree-sitter).
+
+TDL (https://github.com/UnstoppableMango/tdl) describes domain models: types,
+enums, aliases, classes, mixins, primitives and units, with no functions or
+calls. A file contributes its own node, its package's node, and one node per
+named declaration; fields and enum variants are not nodes. Declarations link
+with the existing relations: `references` for a type reference or a `requires`
+constraint, `mixes_in` for `include`, and `implements` for conformance to a
+class or an `instance`. Target blocks configure code generators and add no
+edges.
+
+Names resolve the way the TDL compiler scopes them, closely enough for a graph:
+a bare name to a declaration in the same file and then to one in the prelude
+(`prelude/std.tdl` in a directory above the file), and `alias.Name` through the
+import aliased `alias`. A name neither places is left to a sourceless stub for
+the corpus-level rewire, which binds it only to a unique same-named definition.
+"""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from graphify.extractors.base import (
+    _file_stem,
+    _make_id,
+    _read_source_bytes,
+    _read_text,
+    active_scan_root,
+)
+
+_DECLARATIONS = {
+    "type_decl", "enum_decl", "alias_decl", "class_decl",
+    "mixin_decl", "primitive_decl", "unit_decl",
+}
+
+# Subtrees that hold no type reference: values, constraints, doc text, and the
+# declaration's own parameters.
+_SKIP = {
+    "constraint_block", "deprecated", "directive", "type_params", "kind",
+    "string_lit", "int_lit", "float_lit", "bool_lit", "regex_lit", "list_literal",
+    "dotted_ident", "identifier", "name", "fun_deps", "assoc_type_req",
+}
+
+_PRELUDE = Path("prelude") / "std.tdl"
+
+
+def _language():
+    import tree_sitter_tdl as tstdl
+    from tree_sitter import Language
+    return Language(tstdl.language())
+
+
+def _first(node, kind: str):
+    return next((c for c in node.children if c.type == kind), None)
+
+
+def _declared_names(root, source: bytes) -> dict[str, int]:
+    """Each top-level declaration's name, with the line it is declared on."""
+    names: dict[str, int] = {}
+    for child in root.children:
+        if child.type in _DECLARATIONS:
+            ident = _first(child, "identifier")
+            if ident is not None:
+                names.setdefault(_read_text(ident, source), child.start_point[0] + 1)
+    return names
+
+
+def _find_prelude(path: Path) -> Path | None:
+    """The nearest `prelude/std.tdl` above ``path``, not above the scan root.
+
+    The parents are walked in the form graphify passed the path in, so the
+    prelude's ids match the ones its own extraction mints."""
+    root = active_scan_root()
+    try:
+        root = root.resolve() if root is not None else None
+    except OSError:
+        root = None
+    for directory in (path.parent, *path.parent.parents):
+        candidate = directory / _PRELUDE
+        if candidate.is_file():
+            return candidate
+        try:
+            if root is not None and directory.resolve() == root:
+                break
+        except OSError:
+            break
+    return None
+
+
+_prelude_cache: dict[Path, frozenset[str]] = {}
+
+
+def _prelude_names(prelude: Path) -> frozenset[str]:
+    key = prelude.resolve()
+    names = _prelude_cache.get(key)
+    if names is None:
+        from tree_sitter import Parser
+        source = _read_source_bytes(prelude, warn=False)
+        tree = Parser(_language()).parse(source)
+        names = frozenset(_declared_names(tree.root_node, source))
+        _prelude_cache[key] = names
+    return names
+
+
+def extract_tdl(path: Path) -> dict:
+    """Extract declarations, imports, and type references from a .tdl file."""
+    try:
+        from tree_sitter import Parser
+        language = _language()
+    except ImportError:
+        return {"nodes": [], "edges": [], "error": "tree_sitter_tdl not installed"}
+    except Exception as exc:
+        return {"nodes": [], "edges": [], "error": f"TDL grammar failed to load: {exc}"}
+
+    try:
+        source = _read_source_bytes(path)
+        root = Parser(language).parse(source).root_node
+    except Exception as e:
+        return {"nodes": [], "edges": [], "error": str(e)}
+
+    stem = _file_stem(path)
+    str_path = str(path)
+    nodes: list[dict] = []
+    edges: list[dict] = []
+    seen_ids: set[str] = set()
+    seen_edges: set[tuple[str, str, str]] = set()
+
+    def add_node(nid: str, label: str, line: int, **extra) -> None:
+        if nid not in seen_ids:
+            seen_ids.add(nid)
+            nodes.append({"id": nid, "label": label, "file_type": "code",
+                          "source_file": str_path, "source_location": f"L{line}",
+                          **extra})
+
+    def add_edge(src: str, tgt: str, relation: str, line: int,
+                 confidence: str = "EXTRACTED", target_file: Path | None = None) -> None:
+        if src == tgt or (src, tgt, relation) in seen_edges:
+            return
+        seen_edges.add((src, tgt, relation))
+        edge = {"source": src, "target": tgt, "relation": relation,
+                "confidence": confidence, "source_file": str_path,
+                "source_location": f"L{line}", "weight": 1.0}
+        if target_file is not None:
+            edge["target_file"] = str(target_file)
+        edges.append(edge)
+
+    file_nid = _make_id(str(path))
+    add_node(file_nid, path.name, 1)
+
+    local = _declared_names(root, source)
+    prelude = _find_prelude(path)
+    is_prelude = prelude is not None and prelude.resolve() == path.resolve()
+    prelude_names = _prelude_names(prelude) if prelude is not None and not is_prelude else frozenset()
+
+    imports: dict[str, Path] = {}
+    package_nid: str | None = None
+    for child in root.children:
+        line = child.start_point[0] + 1
+        if child.type == "package_decl":
+            package = ".".join(_read_text(n, source) for n in child.children if n.type == "name")
+            if package:
+                package_nid = _make_id("tdl_package", package)
+                add_node(package_nid, package, line, type="namespace")
+        elif child.type == "import_decl":
+            spec = _first(child, "string_lit")
+            if spec is None:
+                continue
+            # Normalized, so `../x.tdl` mints the ids x.tdl's own extraction does.
+            target = Path(os.path.normpath(path.parent / _read_text(spec, source).strip('"')))
+            add_edge(file_nid, _make_id(str(target)), "imports", line, target_file=target)
+            alias = _first(child, "identifier")
+            if alias is not None and _read_text(alias, source) != "_":
+                imports[_read_text(alias, source)] = target
+
+    def resolve(parts: list[str]) -> tuple[str, str, Path | None]:
+        """A referenced name's node id, confidence, and the file declaring it."""
+        name = parts[-1]
+        if len(parts) == 1:
+            if name in local:
+                return _make_id(stem, name), "EXTRACTED", None
+            if name in prelude_names:
+                return _make_id(_file_stem(prelude), name), "EXTRACTED", prelude
+        elif len(parts) == 2 and parts[0] in imports:
+            target = imports[parts[0]]
+            return _make_id(_file_stem(target), name), "EXTRACTED", target
+        stub = _make_id(name)
+        if stub not in seen_ids:
+            seen_ids.add(stub)
+            nodes.append({"id": stub, "label": name, "file_type": "code",
+                          "source_file": "", "source_location": "",
+                          "origin_file": str_path})
+        return stub, "INFERRED", None
+
+    def dotted(ident) -> list[str]:
+        return [_read_text(c, source) for c in ident.children if c.type == "identifier"]
+
+    def link(src: str, parts: list[str], relation: str, line: int, scope: set[str]) -> None:
+        if not parts or (len(parts) == 1 and parts[0] in scope):
+            return
+        tgt, confidence, target_file = resolve(parts)
+        add_edge(src, tgt, relation, line, confidence, target_file)
+
+    def refs(src: str, node, relation: str, scope: set[str]) -> None:
+        t = node.type
+        if t in _SKIP:
+            return
+        if t == "conforms":
+            relation = "implements"
+        elif t == "include":
+            relation = "mixes_in"
+        elif t == "requires_clause":
+            relation = "references"
+        if t in ("named_type", "class_ref"):
+            ident = _first(node, "dotted_ident")
+            if ident is not None:
+                link(src, dotted(ident), relation, ident.start_point[0] + 1, scope)
+            # Type arguments are references whatever holds them.
+            relation = "references"
+        elif t == "unit_term":
+            # A bare name in `<...>` parses as a unit term, though it may name
+            # a type; the compiler resolves it by kind.
+            for c in node.children:
+                if c.type == "identifier":
+                    link(src, [_read_text(c, source)], "references",
+                         c.start_point[0] + 1, scope)
+        for c in node.children:
+            refs(src, c, relation, scope)
+
+    def params(node) -> set[str]:
+        scope: set[str] = set()
+        tp = _first(node, "type_params")
+        if tp is not None:
+            for p in tp.children:
+                if p.type == "type_param":
+                    ident = _first(p, "identifier")
+                    if ident is not None:
+                        scope.add(_read_text(ident, source))
+        for req in node.children:
+            if req.type == "assoc_type_req":
+                ident = _first(req, "identifier")
+                if ident is not None:
+                    scope.add(_read_text(ident, source))
+        return scope
+
+    for child in root.children:
+        line = child.start_point[0] + 1
+        if child.type in _DECLARATIONS:
+            ident = _first(child, "identifier")
+            if ident is None:
+                continue
+            name = _read_text(ident, source)
+            nid = _make_id(stem, name)
+            add_node(nid, name, line)
+            add_edge(file_nid, nid, "contains", line)
+            if package_nid is not None:
+                add_edge(package_nid, nid, "contains", line)
+            scope = params(child)
+            for c in child.children:
+                refs(nid, c, "references", scope)
+        elif child.type == "instance_decl":
+            # `instance C for T`, or `instance C<T>`: T implements C. The
+            # instance is not a node, so its requires clause and associated
+            # types are T's references.
+            instance_type = _first(child, "named_type")
+            if instance_type is None:
+                args = _first(child, "type_args")
+                ref = _first(args, "type_ref") if args is not None else None
+                instance_type = _first(ref, "named_type") if ref is not None else None
+            cls = _first(child, "dotted_ident")
+            ident = _first(instance_type, "dotted_ident") if instance_type is not None else None
+            if cls is None or ident is None:
+                continue
+            src, _, _ = resolve(dotted(ident))
+            scope = params(child)
+            link(src, dotted(cls), "implements", line, scope)
+            for c in child.children:
+                if c.type in ("requires_clause", "assoc_type_bind"):
+                    refs(src, c, "references", scope)
+
+    return {"nodes": nodes, "edges": edges}
