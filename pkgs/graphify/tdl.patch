+    labels = {n["id"]: n["label"] for n in r["nodes"] if n["source_file"]}
+    refs = {(labels.get(e["source"]), labels.get(e["target"]))
+            for e in r["edges"] if e["relation"] == "references"}
+    assert ("Order", "Money") in refs
